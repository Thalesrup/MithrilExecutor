#!/usr/bin/env php
<?php
declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use MithrilExecutor\Console\ConsoleHelper;
use MithrilExecutor\Queue\FileJobQueue;
use MithrilExecutor\Resolvers\BootstrapResolverLoader;
use MithrilExecutor\Runner\MethodCallRunner;
use MithrilExecutor\Supervisor\ProcessSupervisor;
use MithrilExecutor\ValueObjects\Job;
use MithrilExecutor\Worker\Worker;

$command = ConsoleHelper::cmd();
$storage = ConsoleHelper::arg('storage', __DIR__ . '/../storage');
$bootstrap = ConsoleHelper::arg('bootstrap', null);

try {
    $queue = new FileJobQueue($storage);
    $resolver = BootstrapResolverLoader::load($bootstrap);
    $runner = new MethodCallRunner($resolver);
    $worker = new Worker($queue, $runner);

    // Setup CLI Logger
    $worker->onLog = function(string $msg) {
        $timestamp = date('H:i:s');
        match (true) {
            str_contains($msg, 'Done') => ConsoleHelper::success("[{$timestamp}] {$msg}"),
            str_contains($msg, 'Failed') || str_contains($msg, 'Critical') => ConsoleHelper::error("[{$timestamp}] {$msg}"),
            str_contains($msg, 'Claimed') => ConsoleHelper::info("[{$timestamp}] {$msg}"),
            str_contains($msg, 'Daemon started') => ConsoleHelper::success("[{$timestamp}] {$msg}"),
            str_contains($msg, 'Daemon stopped') => ConsoleHelper::warn("[{$timestamp}] {$msg}"),
            default => ConsoleHelper::println("[{$timestamp}] {$msg}"),
        };
    };

    switch ($command) {
        case 'enqueue': {
            $class = ConsoleHelper::arg('class');
            if (!$class) {
                throw new RuntimeException('Missing --class');
            }
            $ctorJson = ConsoleHelper::arg('ctor', '[]');
            $callsJson = ConsoleHelper::arg('calls', '[]');

            $ctor = json_decode($ctorJson, true);
            $calls = json_decode($callsJson, true);

            if (!is_array($ctor) || !is_array($calls)) {
                throw new RuntimeException('Invalid JSON in --ctor or --calls');
            }

            $job = new Job(
                Job::newId(),
                $class,
                $ctor,
                $calls,
                (int) floor(microtime(true) * 1000),
                null
            );

            $id = $queue->enqueue($job);
            ConsoleHelper::println("Enqueued: {$id}");
            exit(0);
        }

        case 'list': {
            $status = ConsoleHelper::arg('status', 'all');

            // Flag shortcuts
            if (ConsoleHelper::hasFlag('pending')) $status = 'pending';
            if (ConsoleHelper::hasFlag('running')) $status = 'running';
            if (ConsoleHelper::hasFlag('done')) $status = 'done';
            if (ConsoleHelper::hasFlag('failed')) $status = 'failed';

            $jobs = $queue->list($status);

            // Export options
            $format = ConsoleHelper::arg('format'); // json, csv
            $outputFile = ConsoleHelper::arg('output');
            
            if ($format === 'json') {
                $json = json_encode($jobs, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
                if ($outputFile) {
                    if (file_put_contents($outputFile, $json) === false) {
                        ConsoleHelper::error("Failed to write to file: {$outputFile}");
                        exit(1);
                    }
                    ConsoleHelper::success("Output saved to {$outputFile}");
                } else {
                    ConsoleHelper::println($json);
                }
                exit(0);
            }

            if ($format === 'csv') {
                $dest = $outputFile ?: 'php://output';
                $out = fopen($dest, 'w');
                if ($out === false) {
                    ConsoleHelper::error("Failed to open file for writing: {$dest}");
                    exit(1);
                }

                fputcsv($out, ['id', 'status', 'class', 'created_at']);
                foreach ($jobs as $job) {
                    fputcsv($out, [$job['id'], $job['status'], $job['class'], $job['created_at']]);
                }
                fclose($out);

                if ($outputFile) {
                    ConsoleHelper::success("Output saved to {$outputFile}");
                }
                exit(0);
            }

            if (empty($jobs)) {
                ConsoleHelper::println("No jobs found for status: {$status}");
                exit(0);
            }

            ConsoleHelper::println(sprintf(
                "%-30s %-10s %-40s %-20s",
                "JOB ID", "STATUS", "CLASS", "CREATED AT"
            ));
            ConsoleHelper::println(str_repeat("-", 100));

            foreach ($jobs as $job) {
                $statusColor = match ($job['status']) {
                    'done' => '32', // Green
                    'failed' => '31', // Red
                    'running' => '33', // Yellow
                    'pending' => '36', // Cyan
                    default => '0',
                };

                ConsoleHelper::println(sprintf(
                    "%-30s %-10s %-40s %-20s",
                    $job['id'],
                    ConsoleHelper::colorize($job['status'], $statusColor),
                    substr($job['class'], 0, 40),
                    $job['created_at']
                ));
            }
            exit(0);
        }

        case 'run': {
            // executa um job JSON específico (não mexe em queue)
            $file = ConsoleHelper::arg('file');
            if (!$file) throw new RuntimeException('Missing --file=/path/job.json');

            $raw = file_get_contents($file);
            if ($raw === false) throw new RuntimeException("Cannot read job file: {$file}");

            $data = json_decode($raw, true);
            if (!is_array($data)) throw new RuntimeException("Invalid job json: {$file}");

            $job = Job::fromArray($data);
            [$report, $stdout, $stderr] = $runner->run($job);

            ConsoleHelper::println(json_encode($report->toArray(), JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT));
            if ($stdout !== '') { ConsoleHelper::println("\n--- STDOUT ---\n" . $stdout); }
            if ($stderr !== '') { ConsoleHelper::eprintln("\n--- STDERR ---\n" . $stderr); }

            exit($report->ok ? 0 : 2);
        }

        case 'work': {
            $memory = ConsoleHelper::arg('memory');
            if ($memory) {
                ini_set('memory_limit', $memory);
            }

            $quiet = ConsoleHelper::hasFlag('quiet');
            if (!$quiet) {
                ConsoleHelper::info("Running worker in single mode...");
            }
            
            $worked = $worker->workOnce();
            
            if (!$worked) {
                if (!$quiet) {
                    ConsoleHelper::warn("No job found in queue.");
                }
            }
            exit($worked ? 0 : 1);
        }

        case 'daemon': {
            ConsoleHelper::banner();
            $sleep = (int) (ConsoleHelper::arg('sleep', '250') ?? '250');
            $concurrency = (int) (ConsoleHelper::arg('concurrency', '1') ?? '1');
            $memory = ConsoleHelper::arg('memory');
            
            if ($concurrency > 1) {
                // Modo Supervisor (Multi-processo)
                ConsoleHelper::info("Starting Mithril Supervisor (Concurrency: {$concurrency}, Sleep: {$sleep}ms)...");
                if ($memory) {
                    ConsoleHelper::info("Worker memory limit: {$memory} (per process)");
                }
                
                // Monta o comando do worker filho
                // Precisamos garantir que usamos o mesmo PHP e o mesmo script mithril
                $phpBinary = PHP_BINARY;
                $script = realpath(__DIR__ . '/mithril'); // self
                
                // Repassa argumentos críticos e desativa Xdebug nos filhos para limpar output
                // Adiciona --quiet para evitar spam de "Running worker" e "No job found"
                $workerCmd = sprintf(
                    '"%s" -dxdebug.mode=off %s "%s" work --storage="%s" --quiet', 
                    $phpBinary, 
                    $memory ? "-d memory_limit={$memory}" : "",
                    $script, 
                    $storage
                );
                
                if ($bootstrap) {
                    $workerCmd .= sprintf(' --bootstrap="%s"', $bootstrap);
                }
                
                $supervisor = new ProcessSupervisor($queue, $workerCmd, $concurrency, $worker->onLog);
                ConsoleHelper::println("Press Ctrl+C to stop.");
                $supervisor->run($sleep);
                
            } else {
                // Modo Simples (Single-process loop)
                if ($memory) {
                    ini_set('memory_limit', $memory);
                    ConsoleHelper::info("Memory limit set to: {$memory}");
                }
                ConsoleHelper::info("Starting Mithril Worker in Daemon Mode (Single Process, Sleep: {$sleep}ms)...");
                ConsoleHelper::println("Press Ctrl+C to stop.");
                $worker->daemon($sleep);
            }
            exit(0);
        }

        default:
            ConsoleHelper::banner();
            
            ConsoleHelper::println(ConsoleHelper::colorize("Usage:", '33'));
            ConsoleHelper::println("  " . ConsoleHelper::colorize("php bin/mithril <command> [options]", '32'));
            ConsoleHelper::println("");

            ConsoleHelper::println(ConsoleHelper::colorize("Available Commands:", '33'));
            
            $commands = [
                'list'    => 'List jobs based on status, format, etc.',
                'enqueue' => 'Push a new job to the queue manually.',
                'work'    => 'Process a single job from the queue and exit.',
                'daemon'  => 'Start the worker supervisor (supports concurrency).',
                'run'     => 'Execute a specific job file directly (debug mode).',
            ];

            foreach ($commands as $cmd => $desc) {
                ConsoleHelper::println(sprintf(
                    "  %-12s %s",
                    ConsoleHelper::colorize($cmd, '32'), // Green
                    ConsoleHelper::colorize($desc, '33')  // Yellow
                ));
            }

            ConsoleHelper::println("");
            ConsoleHelper::println(ConsoleHelper::colorize("Key Flags:", '33'));

            $flags = [
                '--bootstrap' => 'Path to PHP file that returns ResolverInterface (loads your classes).',
                '--quiet'     => 'Suppress "No job found" and other non-error logs.',
                '--file'      => 'Path to a specific JSON job file (required for "run" command).',
            ];

            foreach ($flags as $flag => $desc) {
                ConsoleHelper::println(sprintf(
                    "  %-12s %s",
                    ConsoleHelper::colorize($flag, '32'),
                    ConsoleHelper::colorize($desc, '37')
                ));
            }

            ConsoleHelper::println("");
            ConsoleHelper::println(ConsoleHelper::colorize("Examples:", '33'));
            
            $examples = [
                "php bin/mithril list --status=failed --format=csv --output=err.csv",
                "php bin/mithril enqueue --class='App\\MyTask' --ctor='[]' --calls='[...]'",
                "php bin/mithril work --memory=512M --quiet",
                "php bin/mithril daemon --concurrency=5 --memory=128M --bootstrap=init.php",
                "php bin/mithril run --file=job.json --bootstrap=init.php"
            ];

            foreach ($examples as $ex) {
                ConsoleHelper::println("  " . ConsoleHelper::colorize($ex, '32'));
            }
            
            exit(0);
    }
} catch (Throwable $e) {
    ConsoleHelper::eprintln("[ERROR] " . $e->getMessage());
    exit(3);
}
